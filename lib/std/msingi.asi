# Msingi (prelude) – interface stub

thabiti KWELI: Ukweli
thabiti SIYO_KWELI: Ukweli
thabiti TUPU: Tupu

kazi orodha() -> Orodha
kazi orodha_rudia(thamani: Unknown, idadi: Namba) -> Orodha
kazi kamusi() -> Kamusi
kazi kamusi_tupu() -> Kamusi
kazi jozi(a: Unknown, b: Unknown) -> Jozi
kazi tokeo(val) -> Tokeo
kazi kosa(ujumbe: Neno) -> Tokeo
kazi chaguo(val) -> Chaguo

kazi seti() -> Seti<T>
kazi seti_tupu() -> Seti<T>
kazi kumbukumbu_unda(thamani: T) -> Kumbukumbu<T>

# Kiolesura cha moduli ya `majira`, kwa Asili.
# Imetengenezwa kutoka core/parser/src/builtins.rs (BUILTIN_MODULES) — usihariri faili hili;
# badilisha jedwali, kisha: ASILI_GOLDEN=write cargo test -p pata-core stdlib_stubs
#
# Majira: saa, tarehe na muda (UTC, kalenda ya Gregori).

# Sekunde za 1970-01-01 UTC (0).
thabiti MWANZO_WA_ZAMANI: Namba
# 86400.
thabiti SEKUNDE_KWA_SIKU: Namba

# Sekunde za saa isiyorudi nyuma, za kupima muda.
kazi kipima_muda() -> Namba

# Wakati kutoka ISO 8601 ("2026-10-09T12:30:00Z", au yenye +03:00).
kazi kutoka_iso(maandishi: Neno) -> Tokeo<Wakati, Neno>

# Wakati wa sekunde n tangu 1970-01-01 UTC.
kazi kutoka_sekunde(n: Namba) -> Wakati

# Wakati wa saa sita usiku (UTC) wa tarehe hiyo; kosa tarehe isipokuwepo.
kazi kutoka_tarehe(mwaka: Namba, mwezi: Namba, siku: Namba) -> Tokeo<Wakati, Neno>

# Tarehe na saa kwa ISO 8601 (UTC): "2026-10-09T12:30:00Z".
kazi kwa_iso(w: Wakati) -> Neno

# Subiri kwa sekunde hizo.
kazi lala(sekunde: Namba) -> Tupu

# Sekunde tangu 1970-01-01 UTC, sasa hivi.
kazi majira() -> Namba

# Wakati wa sasa.
kazi sasa() -> Wakati

# Sekunde za w tangu 1970-01-01 UTC.
kazi sekunde(w: Wakati) -> Namba

# mwaka, mwezi, siku, saa, dakika, sekunde, siku_ya_wiki (1 = Jumatatu), siku_ya_mwaka.
kazi tarehe(w: Wakati) -> Kamusi<Neno, Namba>

# "2026-10-09 12:30:00" (UTC).
kazi umbiza(w: Wakati) -> Neno

# Kama umbiza, kwa saa za eneo lililo dakika `dakika` mbele ya UTC.
kazi umbiza_eneo(w: Wakati, dakika: Namba) -> Neno

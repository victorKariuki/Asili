# Sambamba (concurrency) – interface stub
# Mfumo wa nyuzi 1:1 za OS. `tenda` inapokea jina la kazi na hoja za kazi hiyo (idadi yoyote).

kazi tenda(kazi_jina: Neno) -> Tokeo<Namba, Neno>
kazi subiri_tenda(uzi_id: Namba) -> Tokeo<Tupu, Neno>
kazi njia() -> Jozi<NjiaTx<T>, NjiaRx<T>>
kazi njia_na_kikomo(kikomo: Namba) -> Jozi<NjiaTxBounded<T>, NjiaRxBounded<T>>
kazi fungo(thamani: T) -> Tokeo<Fungo<T>, Neno>

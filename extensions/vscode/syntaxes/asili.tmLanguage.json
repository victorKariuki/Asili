{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Asili",
  "scopeName": "source.asili",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.asili"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.asili",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.asili" }
      ]
    },
    "char": {
      "match": "'(\\\\[nt'\\\\]|.)'",
      "name": "string.quoted.single.asili"
    },
    "number": {
      "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b",
      "name": "constant.numeric.asili"
    },
    "keyword": {
      "match": "\\b(leta|kazi|umbo|sifa|shughuli|ya|weka|thabiti|rejesha|ikiwa|vinginevyo|kwa|wakati|milele|linganisha|vunja|endelea|lebo|tupa|jaribu|kama|azima|azima_tenda|au_ikiwa|chapisha|paparika|kweli|si_kweli|Hamna|Tupu|Namba|Neno|Ukweli|Orodha|Kamusi|Jozi|Herufi|Tokeo|Chaguo)\\b",
      "name": "keyword.control.asili"
    },
    "identifier": {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.asili"
    }
  }
}

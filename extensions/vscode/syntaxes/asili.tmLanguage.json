{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Asili",
  "scopeName": "source.asili",
  "patterns": [
    { "include": "#comment" },
    { "include": "#attribute" },
    { "include": "#import-stmt" },
    { "include": "#type-def" },
    { "include": "#impl-def" },
    { "include": "#function-def" },
    { "include": "#variable-declaration" },
    { "include": "#bytes" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#number" },
    { "include": "#keyword-control" },
    { "include": "#keyword-operator" },
    { "include": "#constant-language" },
    { "include": "#builtin-type" },
    { "include": "#builtin-function" },
    { "include": "#method-call" },
    { "include": "#member-access" },
    { "include": "#function-call" },
    { "include": "#type-annotation" },
    { "include": "#type-ref" },
    { "include": "#operator" },
    { "include": "#punctuation" },
    { "include": "#storage-keyword" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "match": "#(?!\\[).*$",
          "name": "comment.line.number-sign.asili"
        },
        {
          "match": "///.*$",
          "name": "comment.line.documentation.asili"
        }
      ]
    },
    "attribute": {
      "begin": "#\\[",
      "end": "\\]",
      "name": "meta.attribute.asili",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.attribute.begin.asili" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.attribute.end.asili" }
      },
      "patterns": [
        {
          "match": "\\b(jaribio|sharti|ndani|kiunganishi)\\b",
          "name": "entity.other.attribute-name.asili"
        },
        { "include": "#bytes" },
    { "include": "#string" },
        { "include": "#number" },
        { "include": "#punctuation" }
      ]
    },
    "bytes": {
      "begin": "\\bb\"",
      "end": "\"",
      "name": "string.quoted.double.bytes.asili",
      "patterns": [
        { "match": "\\\\(x[0-9a-fA-F]{2}|[ntr0\"\\\\])", "name": "constant.character.escape.asili" }
      ]
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.asili",
      "patterns": [
        { "match": "\\\\(u\\{[0-9a-fA-F]+\\}|[ntr0\"\\\\])", "name": "constant.character.escape.asili" }
      ]
    },
    "char": {
      "match": "'(\\\\[ntr0'\\\\]|[^'])'",
      "name": "string.quoted.single.asili",
      "captures": {
        "1": { "name": "constant.character.escape.asili" }
      }
    },
    "number": {
      "match": "\\b(0x[0-9a-fA-F]+|0b[01]+|0o[0-7]+)\\b|\\b([0-9]+(\\.[0-9]*)?|\\.\\d+)([eE][+-]?[0-9]+)?\\b",
      "name": "constant.numeric.asili"
    },
    "import-stmt": {
      "match": "\\b(leta)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.import.asili" },
        "2": { "name": "entity.name.namespace.asili" }
      }
    },
    "type-def": {
      "match": "\\b(umbo|jenum|sifa)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.asili" },
        "2": { "name": "entity.name.type.asili" }
      }
    },
    "impl-def": {
      "match": "\\b(shughuli)\\s+(ya)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.asili" },
        "2": { "name": "storage.type.asili" },
        "3": { "name": "entity.name.type.asili" }
      }
    },
    "function-def": {
      "begin": "\\b(kazi)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
      "end": "\\)",
      "name": "meta.function.definition.asili",
      "beginCaptures": {
        "1": { "name": "storage.type.function.asili" },
        "2": { "name": "entity.name.function.asili" },
        "3": { "name": "punctuation.definition.parameters.begin.asili" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.asili" }
      },
      "patterns": [
        {
          "match": "\\b(azima|thabiti)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.asili" },
            "2": { "name": "variable.parameter.asili" }
          }
        },
        {
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": { "name": "variable.parameter.asili" },
            "2": { "name": "punctuation.separator.type.asili" }
          }
        },
        { "include": "#builtin-type" },
        { "include": "#type-ref" },
        { "include": "#punctuation" }
      ]
    },
    "variable-declaration": {
      "match": "\\b(weka|thabiti)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.asili" },
        "2": { "name": "variable.other.definition.asili" }
      }
    },
    "block": {
      "begin": "\\{",
      "end": "\\}",
      "name": "meta.block.asili",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.block.begin.asili" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.asili" }
      },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "keyword-control": {
      "match": "\\b(ikiwa|vinginevyo|au_ikiwa|wakati|milele|kwa|kutoka|hadi|katika|linganisha|vunja|endelea|rejesha|lebo|tupa|subiri)\\b",
      "name": "keyword.control.asili"
    },
    "storage-keyword": {
      "match": "\\b(weka|thabiti|umma|sawia)\\b",
      "name": "storage.modifier.asili"
    },
    "keyword-operator": {
      "patterns": [
        {
          "match": "\\b(kama|azima|azima_tenda)\\b",
          "name": "keyword.operator.cast.asili"
        },
        {
          "match": "\\b(na|au|siyo)\\b",
          "name": "keyword.operator.logical.asili"
        },
        {
          "match": "\\b(jaribu|na_biti|au_biti|xor_biti|siyo_biti)\\b",
          "name": "keyword.operator.bitwise.asili"
        },
        {
          "match": "\\b(sogeza_kulia|sogeza_kushoto)\\b",
          "name": "keyword.operator.bitwise.asili"
        }
      ]
    },
    "constant-language": {
      "match": "\\b(kweli|si_kweli|Hamna)\\b",
      "name": "constant.language.asili"
    },
    "builtin-type": {
      "match": "\\b(Namba|Neno|Baiti|Ukweli|Herufi|Tupu|Hamna|Orodha|Kamusi|Seti|Jozi|Chaguo|Tokeo|Wakati|Anuani|Namba_Kuu|Namba_Sahihi|Kumbukumbu|Kasha_GC|Kasha_GC_Dhaifu|Faili|Mkondo|MkondoSikilizaji|TlsUsanidi|NjiaTx|NjiaRx|Fungo|Ahadi|Biti8|Biti16|Biti32|Biti64|uBiti8|uBiti16|uBiti32|uBiti64|OmbiHttp|JibuHttp|ChaguoMkondo|ChaguoSikiliza|ChaguoHttp)\\b",
      "name": "support.type.asili"
    },
    "builtin-function": {
      "begin": "\\b(abs|absolute|akosini|akosini_h|andika_baiti|andika_faili|anzisha|arch|asini|asini_h|atanjenti|atanjenti2|atanjenti_h|badili_jina|baiti|baiti_ya_nambari|baki|base64_fumbua|base64_fumbua_baiti|base64_simba|chagua_nasibu|chaguo|changanya|chapisha|dari|duara|duara_maeneo|endesha|expm1|faili_fungua|faktoriali|fungo|futa|futa_saraka|gawio|ghairi|haipot|hashi_sha256|hashi_sha512|hex_fumbua|hex_simba|hmac_sha256|http_ombi|ishara|jina_os|jozi|jumla|kamusi|kamusi_tupu|kasha_gc_dhaifu|kasha_gc_unda|kikomo_kumbukumbu|kikwazo|kipeo|kipeuo2|kipeuo3|kipima_muda|kitambulisho|kosa|kosini|kosini_h|kubwa|kumbukumbu_unda|kutoka_iso|kutoka_json|kutoka_sekunde|kutoka_tarehe|kwa_iso|kwa_json|kwenda_nyuzi|kwenda_radiani|lala|logi|logi10|logi1p|logi2|majira|makosa|mazingira|mizizi|mkondo_sikiliza|mkondo_tumikia|mkondo_tumikia_http|mkondo_unganisha|mlinzi_anza|mlinzi_lisha|muda_kikomo|muda_wa_kuanza|mzizi|nakili|namba_kuu_kutoka|namba_sahihi_kutoka|nasibu|nasibu_chini|nasibu_kamili|nasibu_mbegu|ndogo|ni_debug|ni_faili|ni_namba|ni_saraka|ni_ukomo|ni_wasm|njia|njia_jina|njia_kamili|njia_kiendelezi|njia_mzazi|njia_na_kikomo|njia_unganisha|omba|ongeza|ongeza_baiti|onyo|orodha|orodha_rudia|orodha_saraka|paparika|pata_env|punguza|rejesha_ishara|ruwaza_badilisha|ruwaza_gawanya|ruwaza_inalingana|ruwaza_tafuta|ruwaza_vikundi|ruwaza_zote|sakafu|sasa|saza_kiungo|sekunde|seti|seti_tupu|si_namba|sikiliza_ishara|sini|sini_h|soma_baiti|soma_faili|subiri_tenda|subiri_yoyote|subiri_zote|syscall|tafuta_anwani|tanjenti|tanjenti_h|tarehe|tenda|tls_sanidi|tofauti|toka|tokeo|toleo|ukubwa|umbiza|umbiza_eneo|unda_saraka|upeo|upeo_wa_e|vigezo|vipo|weka_env|wito_kiungo|zao)\\s*(\\()",
      "end": "\\)",
      "name": "meta.function-call.builtin.asili",
      "beginCaptures": {
        "1": { "name": "support.function.builtin.asili" },
        "2": { "name": "punctuation.definition.arguments.begin.asili" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.arguments.end.asili" }
      },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "method-call": {
      "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "punctuation.accessor.asili" },
        "2": { "name": "variable.function.asili" }
      }
    },
    "member-access": {
      "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.accessor.asili" },
        "2": { "name": "variable.other.member.asili" }
      }
    },
    "function-call": {
      "begin": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(\\()",
      "end": "\\)",
      "name": "meta.function-call.asili",
      "beginCaptures": {
        "1": { "name": "variable.function.asili" },
        "2": { "name": "punctuation.definition.arguments.begin.asili" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.arguments.end.asili" }
      },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "type-annotation": {
      "match": "(:)(?!:)\\s*([A-Z][a-zA-Z0-9_]*)?",
      "captures": {
        "1": { "name": "punctuation.separator.type.asili" },
        "2": { "name": "entity.name.type.asili" }
      },
      "name": "meta.type-annotation.asili"
    },
    "type-ref": {
      "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b",
      "name": "entity.name.type.asili"
    },
    "operator": {
      "patterns": [
        {
          "match": "->|=>|::",
          "name": "keyword.operator.compound.asili"
        },
        {
          "match": "\\*\\*=|\\*\\*|==|!=|>=|<=",
          "name": "keyword.operator.comparison.asili"
        },
        {
          "match": "&&|\\|\\|",
          "name": "keyword.operator.logical.asili"
        },
        {
          "match": "//=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=",
          "name": "keyword.operator.assignment.asili"
        },
        {
          "match": "//|[+\\-*/%]",
          "name": "keyword.operator.arithmetic.asili"
        },
        {
          "match": "[<>!&|^~?]",
          "name": "keyword.operator.comparison.asili"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[,;]",
          "name": "punctuation.separator.asili"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.asili"
        },
        {
          "match": "[\\(\\)\\[\\]\\{\\}]",
          "name": "punctuation.bracket.asili"
        }
      ]
    },
    "identifier": {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.readwrite.asili"
    }
  }
}
